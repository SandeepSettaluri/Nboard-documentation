umentation\/GCVCardReader","abstract":[{"type":"text","text":"GVCCardReader is a comprehensive framework designed to facilitate end-to-end Know Your Customer (KYC) verification for users residing in the United Arab Emirates. It supports Emirates ID capture via Near Field Communication (NFC) or Optical Character Recognition (OCR), with captured data subsequently validated through the Identity and Citizenship Authority (ICA) API. Upon successful verification, the framework conducts a liveness assessment to confirm the physical presence of the user, followed by a biometric face comparison to ensure the individual matches the Emirates ID document holder."}],"title":"GCVCardReader","role":"collection"},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader/EIDAScanResult/idNumberScannedFromFrontSide":{"url":"\/documentation\/gcvcardreader\/eidascanresult\/idnumberscannedfromfrontside","abstract":[{"text":"ID Number from EIDA Card front side","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"idNumberScannedFromFrontSide"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"title":"idNumberScannedFromFrontSide","kind":"symbol","identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/EIDAScanResult\/idNumberScannedFromFrontSide","type":"topic"},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader/EIDAScanResult/isDobValidated":{"abstract":[],"identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/EIDAScanResult\/isDobValidated","kind":"symbol","url":"\/documentation\/gcvcardreader\/eidascanresult\/isdobvalidated","title":"isDobValidated","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDobValidated"},{"kind":"text","text":": "},{"kind":"typeIdentifier","p
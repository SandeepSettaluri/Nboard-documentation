nresult","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EIDAScanResult"}],"abstract":[{"text":"Model to return OCR scan result","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EIDAScanResult"}],"title":"EIDAScanResult","identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/EIDAScanResult","role":"symbol","type":"topic"},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader/GcCardReader":{"kind":"symbol","url":"\/documentation\/gcvcardreader\/gccardreader","title":"GcCardReader","role":"symbol","navigatorTitle":[{"text":"GcCardReader","kind":"identifier"}],"abstract":[{"type":"text","text":"GcCardReader: Defines public class for the framework. Use the shared instance of this to use methods related to card scanning and NFC connection."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GcCardReader","kind":"identifier"}],"identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/GcCardReader","type":"topic"},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader":{"kind":"symbol","url":"\/documentation\/gcvcardreader","type":"topic","identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader","abstract":[{"type":"text","text":"GVCCardReader is a comprehensive framework designed to facilitate end-to-end Know Your Customer (KYC) verification for users residing in the United Arab Emirates. It supports Emirates ID capture via Near Field Communication (NFC) or Optical Character Recognition (OCR), with captured data subsequently validated through the Identity and Citizenship Authority (ICA) API. Upon successful verification, the framework conducts a liveness assessment to confirm the physical presence of the user, followed by a biometric face comparison to ensure the individual matches the Emirates ID document holder."}],"title":"GCVCardReader","role"
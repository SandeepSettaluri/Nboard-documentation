,"text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BahrainIDScanResult"}]},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader/BahrainIDScanResult/cardFrontImage":{"abstract":[{"text":"Front side of EIDA Card","type":"text"}],"url":"\/documentation\/gcvcardreader\/bahrainidscanresult\/cardfrontimage","identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/BahrainIDScanResult\/cardFrontImage","type":"topic","role":"symbol","kind":"symbol","title":"cardFrontImage","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cardFrontImage"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIImage","text":"UIImage"},{"kind":"text","text":"?"}]},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader":{"kind":"symbol","url":"\/documentation\/gcvcardreader","type":"topic","identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader","abstract":[{"type":"text","text":"GVCCardReader is a comprehensive framework designed to facilitate end-to-end Know Your Customer (KYC) verification for users residing in the United Arab Emirates. It supports Emirates ID capture via Near Field Communication (NFC) or Optical Character Recognition (OCR), with captured data subsequently validated through the Identity and Citizenship Authority (ICA) API. Upon successful verification, the framework conducts a liveness assessment to confirm the physical presence of the user, followed by a biometric face comparison to ensure the individual matches the Emirates ID document holder."}],"title":"GCVCardReader","role":"collection"}}}
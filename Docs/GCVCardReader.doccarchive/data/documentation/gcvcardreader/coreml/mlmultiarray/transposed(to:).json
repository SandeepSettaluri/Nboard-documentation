angesns.GCVCardReader\/documentation\/GCVCardReader","abstract":[{"type":"text","text":"GVCCardReader is a comprehensive framework designed to facilitate end-to-end Know Your Customer (KYC) verification for users residing in the United Arab Emirates. It supports Emirates ID capture via Near Field Communication (NFC) or Optical Character Recognition (OCR), with captured data subsequently validated through the Identity and Citizenship Authority (ICA) API. Upon successful verification, the framework conducts a liveness assessment to confirm the physical presence of the user, followed by a biometric face comparison to ensure the individual matches the Emirates ID document holder."}],"title":"GCVCardReader","role":"collection"},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader/CoreML/MLMultiArray":{"identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/CoreML\/MLMultiArray","url":"\/documentation\/gcvcardreader\/coreml\/mlmultiarray","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MLMultiArray","kind":"identifier","preciseIdentifier":"c:objc(cs)MLMultiArray"}],"type":"topic","abstract":[],"kind":"symbol","role":"symbol","title":"MLMultiArray","navigatorTitle":[{"text":"MLMultiArray","kind":"identifier"}]},"doc://com.gamechangesns.GCVCardReader/documentation/GCVCardReader/CoreML":{"identifier":"doc:\/\/com.gamechangesns.GCVCardReader\/documentation\/GCVCardReader\/CoreML","url":"\/documentation\/gcvcardreader\/coreml","type":"topic","abstract":[],"kind":"symbol","role":"collection","title":"CoreML"}}}